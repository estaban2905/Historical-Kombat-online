# Copia a server/.env solo si quieres cambiar algo; `npm run dev:local` funciona sin nada
# (cuentas con PGlite en .dev-data). En Railway estas variables van en cada entorno.
PORT=8787
# Postgres real; vacío = sin cuentas (npm run dev) o PGlite (npm run dev:local).
DATABASE_URL=
# Orígenes de la web que pueden llamar a la API. Vacío = cualquiera (local).
ALLOWED_ORIGINS=
# Swagger en /docs: true en local y develop, false en producción.
DOCS_ENABLED=true
# Vacío = el inicio de sesión con Google está apagado.
GOOGLE_CLIENT_ID=
