{
  "name": "history-combat-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sirve el juego de History Combat exportado a Web.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "precompress": "node scripts/precompress.mjs public"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
