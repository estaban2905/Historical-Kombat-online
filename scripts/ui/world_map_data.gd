## Convierte una lista plana [lon, lat, lon, lat...] en puntos de pantalla.
static func to_points(flat: Array) -> PackedVector2Array:
	var pts := PackedVector2Array()
	var i := 0
	while i + 1 < flat.size():
		pts.append(project(float(flat[i]), float(flat[i + 1])))
		i += 2
	return pts
