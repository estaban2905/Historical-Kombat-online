## Si un rival no tiene ciudad (personajes nuevos), se reparte por el mundo según su identificador.
static func city_of(id: StringName) -> Array:
	if CITIES.has(id):
		return CITIES[id]
	var h := absi(hash(str(id)))
	return ["TIERRA DE " + str(id).to_upper().replace("_", " "), -150.0 + float(h % 3000) / 10.0, -30.0 + float((h / 3000) % 900) / 10.0]

